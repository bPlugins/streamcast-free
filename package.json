{
  "name": "streamcast",
  "version": "2.4.7",
  "description": "Play iceCast, Shoutcast, Radioco, Radionomy Live stream in Wordpress.",
  "author": "bPlugins",
  "license": "GPL-2.0-or-later",
  "main": "build/index.js",
  "scripts": {
    "start": "wp-scripts start",
    "lint:js": "wp-scripts lint-js",
    "lint:css": "wp-scripts lint-style",
    "format": "wp-scripts format",
    "i18n": "wp i18n make-pot . languages/streamcast.pot --exclude=\"build,node_modules,vendor,bundled,zip,.git\"",
    "build": "wp-scripts build && npm run i18n && gulp package"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^5.15.4",
    "codemirror": "^5.65.7",
    "font-awesome": "^4.7.0",
    "immer": "^10.1.1",
    "leaflet": "^1.9.2",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^7.2.0"
  },
  "devDependencies": {
    "@wordpress/scripts": "^27.9.0",
    "eslint-webpack-plugin": "^4.2.0",
    "gulp": "^5.0.0",
    "gulp-cli": "^3.0.0",
    "gulp-zip": "^6.1.0"
  }
}
